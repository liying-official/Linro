{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".build",
    "sourceMap": false,
    "types": [],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "apps/redirect/src/**/*.ts",
    "apps/admin/src/worker/**/*.ts",
    "packages/shared/src/**/*.ts",
    "apps/admin/src/web/csv.ts"
  ]
}
