{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "noEmit": true,
    "types": ["react", "react-dom"]
  },
  "include": ["apps/admin/src/web/**/*.tsx", "apps/admin/src/web/**/*.ts"]
}
